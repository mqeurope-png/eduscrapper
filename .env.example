OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-5.4-mini
OPENAI_MODEL_STRONG=gpt-5.4
OPENAI_SEARCH_MODEL=gpt-4o-mini
# Opcional: para usar el proveedor de búsqueda Brave (mucho más barato que
# OpenAI web_search). Crea una clave gratis en https://api.search.brave.com
BRAVE_API_KEY=
BRAVE_COUNTRY=ES
REQUEST_TIMEOUT=15
MAX_PAGES_PER_DOMAIN=8
MAX_CONCURRENT_REQUESTS=5
