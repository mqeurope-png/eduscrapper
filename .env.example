OPENAI_API_KEY=
# Real OpenAI model IDs. Use what your account has access to:
#   gpt-4o-mini / gpt-4o  -> available on every paid account, cheap+fast
#   gpt-5-mini  / gpt-5   -> if your account has GPT-5 access
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_STRONG=gpt-4o
OPENAI_SEARCH_MODEL=gpt-4o-mini
# Opcional: para usar el proveedor de búsqueda Brave (mucho más barato que
# OpenAI web_search). Crea una clave gratis en https://api.search.brave.com
BRAVE_API_KEY=
BRAVE_COUNTRY=ES
REQUEST_TIMEOUT=15
OPENAI_REQUEST_TIMEOUT=25
MAX_PAGES_PER_DOMAIN=14
MAX_CONCURRENT_REQUESTS=5
MAX_EMAILS_CLASSIFIED_PER_COMPANY=8
